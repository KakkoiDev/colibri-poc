# A hash table maps keys to buckets using a hash function
# (which runs in O(1) expected time, independent of key size).
# If collisions occur, keys are often stored in a linked list
# or via linear probing. The table may be resized when it
# becomes too full, and keys rehashed. Operations like
# lookup, insert, and delete typically run in O(1) average
# time, but O(n) worst case if many collisions occur.

class HashTable:
    def __init__(self, size=8):
        self.size = size
        self.b
