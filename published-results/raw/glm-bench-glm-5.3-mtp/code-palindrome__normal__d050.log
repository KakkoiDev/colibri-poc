def is_palindrome(s):
    """
    Return True if the string s reads the same forwards and backwards,
    ignoring case.

    An empty string is considered a palindrome (it "reads" the same
    both ways, trivially). Strings of length 1 are also palindromes.

    Examples:
        >>> is_palindrome("racecar")
        True
        >>> is_palindrome("RaceCar")
        True
        >>> is_palindrome("hello")
        False
        >>> is_palindrome("")
        True
        >>> is_palindrome("a")
        True
    """
